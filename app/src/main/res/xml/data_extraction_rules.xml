<?xml version="1.0" encoding="utf-8"?>
<!--
  Applied to both transports: cloud-backup covers Android backup and Seedvault,
  device-transfer covers a direct phone-to-phone move. Neither should carry coordinates
  or a cached forecast.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="standby_device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="standby_device.xml" />
    </device-transfer>
</data-extraction-rules>
