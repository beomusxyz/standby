<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for API 24-30. res/xml/data_extraction_rules.xml covers 31+ and has to
  say the same thing.

  What the user chose is worth carrying to a new phone: their settings, their installed
  plugins, their page layouts, the city they picked. What this device worked out is not:
  coordinates, the resolved city name, the cached forecast.

  SharedPreferences can only be included or excluded a whole file at a time, which is why
  those live in a separate standby_device file rather than being excluded key by key.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="standby_device.xml" />
</full-backup-content>
